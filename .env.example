# ==========================================
# AI Medical Assistant - Environment Config
# ==========================================

# Server
APP_NAME=AI Medical Assistant
APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security (Generate a strong random 32+ char secret in production)
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For PostgreSQL or Supabase, set:
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/ai_medical_assistant
# For local development without PostgreSQL installed, SQLite works out of the box:
DATABASE_URL=sqlite:///./ai_medical_assistant.db

# AI Provider Configuration (Server-Side Only - Never expose in frontend)
# Options: openai | openai_compatible
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional: Local OCR (Tesseract executable path if not on PATH)
TESSERACT_CMD=

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
